    "test:e2e": "vitest run tests/e2e --reporter=verbose",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@cex/exchange-types": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "hono": "^4.13.3"
  },
  "devDependencies": {
    "@cex/typescript-config": "workspace:*",
    "@types/node": "^20.19.43",
    "tsx": "^4.20.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
