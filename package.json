{
  "name": "cex",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @cex/web dev",
    "dev:turbo": "turbo run dev --filter=@cex/web",
    "build": "turbo run build",
    "lint": "turbo run lint --filter=@cex/web",
    "db:generate": "turbo run db:generate --filter=@cex/db",
    "db:migrate": "pnpm --filter @cex/db migrate",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f",
    "dev:exchange": "pnpm --filter @cex/exchange dev",
    "dev:exchange:perp": "EXCHANGE_MARKET=SOL-USD-PERP EXCHANGE_PORT=4011 pnpm --filter @cex/exchange dev",
    "dev:gateway": "EXCHANGE_URL=http://127.0.0.1:4010 EXCHANGE_PERP_URL=http://127.0.0.1:4011 pnpm --filter @cex/engine-gateway dev",
    "dev:market-data": "pnpm --filter @cex/market-data-writer dev",
    "dev:oms": "pnpm --filter @cex/oms dev",
    "test:oms": "pnpm --filter @cex/oms test",
    "test:oms:integration": "pnpm --filter @cex/oms test:integration",
    "test:exchange": "pnpm --filter @cex/exchange test",
    "test:exchange:unit": "pnpm --filter @cex/exchange test:unit",
    "test:exchange:integration": "pnpm --filter @cex/exchange test:integration",
    "test:exchange:e2e": "pnpm --filter @cex/exchange test:e2e",
    "test:market-data": "pnpm --filter @cex/market-data-writer test"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=20"
  }
}
