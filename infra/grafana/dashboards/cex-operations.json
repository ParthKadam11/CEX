    "list": [
      {
        "name": "service",
        "label": "service",
        "type": "custom",
        "query": "exchange,gateway,oms,ingester,web",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        },
        "options": []
      },
      {
        "name": "stream",
        "label": "stream",
        "type": "custom",
        "query": "out,error",
        "includeAll": true,
        "allValue": ".*",
