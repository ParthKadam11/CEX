  "description": "Fleet overview for incidents — all CEX services, then drill into gateway / OMS / ingester / exchange / web + logs.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": true,
      "icon": "dashboard",
      "includeVars": true,
      "keepTime": true,
      "tags": ["cex"],
      "title": "Other CEX dashboards",
      "type": "dashboards"
    }
  ],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "1 · Fleet status (glance)",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Green = process answering /metrics. Red = down or scrape failed.",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "index": 0, "text": "DOWN" },
                "1": { "color": "green", "index": 1, "text": "UP" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 16, "x": 0, "y": 1 },
      "id": 1,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "title": "Services",
      "type": "stat",
      "targets": [
        {
          "expr": "cex_service_up{service=\"exchange\"}",
          "legendFormat": "exchange",
          "refId": "A"
        },
        {
          "expr": "cex_gateway_up",
          "legendFormat": "gateway",
          "refId": "B"
        },
        {
          "expr": "cex_service_up{service=\"oms\"}",
          "legendFormat": "oms",
          "refId": "C"
        },
        {
          "expr": "cex_service_up{service=\"ingester\"}",
          "legendFormat": "ingester (MD)",
          "refId": "D"
        },
        {
          "expr": "cex_service_up{service=\"web\"}",
          "legendFormat": "web",
          "refId": "E"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Quick incident signals. Fail rate > 0 or lag climbing = dig into detail rows below.",
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.01 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "SSE" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": { "color": "red", "text": "DISCONNECTED" },
                      "1": { "color": "green", "text": "CONNECTED" }
                    },
                    "type": "value"
                  }
                ]
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "green", "value": 1 }
                  ]
                }
              }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "sim" },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "options": {
                      "0": { "color": "orange", "text": "OFF" },
                      "1": { "color": "green", "text": "ON" }
                    },
                    "type": "value"
                  }
                ]
              }
            ]
          }
        ]
      },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 1 },
      "id": 2,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "value_and_name"
      },
      "title": "Incident signals",
      "type": "stat",
      "targets": [
        {
          "expr": "cex_gateway_sse_connected",
          "legendFormat": "SSE",
          "refId": "A"
        },
        {
          "expr": "rate(cex_gateway_commands_failed_total[5m])",
          "legendFormat": "cmd fail/s",
          "refId": "B"
        },
        {
          "expr": "max(cex_stream_lag) or vector(0)",
          "legendFormat": "max stream lag",
          "refId": "C"
        },
        {
          "expr": "cex_sim_heartbeat_enabled",
          "legendFormat": "sim",
          "refId": "D"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "options": {
                "0": { "color": "red", "text": "BAD" },
                "1": { "color": "green", "text": "OK" }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
