# Database (used by @cex/db / Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cex"

# NextAuth (apps/web)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Solana RPC (optional; defaults to mainnet-beta)
# Use a dedicated RPC provider in production — public endpoints rate-limit easily.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
