# Database (used by @cex/db / Prisma)
DATABASE_URL="postgresql://postgres:mysecretpassword@localhost:5432/postgres"
TIMESCALE_URL="postgresql://cex:cex@localhost:5434/cex_md"
MARKET_DATA_URL="http://127.0.0.1:4040"
MARKET_DATA_INTERNAL_TOKEN="local-dev-market-data-token"

# Exchange (one process hosts spot + perps on :4010 by default)
EXCHANGE_URL="http://127.0.0.1:4010"
# Optional: comma-separated markets for the exchange process (default SOL-USD,SOL-USD-PERP).
# EXCHANGE_MARKETS="SOL-USD,SOL-USD-PERP"
# Optional: only set if you run a separate perp process. Defaults to EXCHANGE_URL.
# EXCHANGE_PERP_URL="http://127.0.0.1:4010"
EXCHANGE_GATEWAY_TOKEN="local-dev-exchange-token"

# Engine gateway
GATEWAY_PORT=4020
GATEWAY_INTERNAL_TOKEN="local-dev-gateway-token"
ENGINE_GATEWAY_URL="http://127.0.0.1:4020"
ENGINE_GATEWAY_INTERNAL_TOKEN="local-dev-gateway-token"

# OMS
OMS_URL="http://127.0.0.1:4030"
OMS_INTERNAL_TOKEN="local-dev-oms-token"

# NextAuth (apps/web/.env — Next only loads env from the app directory)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Solana — Devnet custodial deposits (put in apps/web/.env)
# RPC must be Devnet. Mainnet is always rejected by @cex/solana.
# Testnet only if SOLANA_ALLOW_NON_DEVNET=true.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_ALLOW_NON_DEVNET=true
# 32-byte AES key for SolWallet.encryptedPrivateKey (64 hex chars).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SOLANA_WALLET_MASTER_KEY=
# Meetup / shared demo: keep false. Local-only paper SOL mint:
ALLOW_PAPER_SOL_CREDIT=false
# Must also be true to show the Home "Demo mint" button:
# NEXT_PUBLIC_ALLOW_PAPER_SOL_CREDIT=true

# Redis (gateway / OMS / withdraw command wait)
REDIS_URL=redis://127.0.0.1:6379

# Deposit watcher (apps/deposit-watcher)
DEPOSIT_WATCHER_PORT=4050
DEPOSIT_POLL_MS=5000
DEPOSIT_MIN_LOTS=1
# confirmed | finalized
DEPOSIT_COMMITMENT=confirmed
