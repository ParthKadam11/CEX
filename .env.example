# =============================================================================
# CEX local development defaults
# Copy via: pnpm setup:local  (writes packages/db/.env + apps/web/.env if missing)
# Backend services also load a root .env when present.
# =============================================================================

# --- Postgres (Prisma / OMS / web) — matches infra/docker-compose.yml ---
DATABASE_URL="postgresql://postgres:mysecretpassword@127.0.0.1:5432/postgres"

# --- Timescale (ingester history) ---
TIMESCALE_URL="postgresql://cex:cex@127.0.0.1:5434/cex_md"
MARKET_DATA_URL="http://127.0.0.1:4040"
MARKET_DATA_INTERNAL_TOKEN="local-dev-market-data-token"
INGESTER_INTERNAL_TOKEN="local-dev-market-data-token"

# --- Redis (gateway / OMS / streams) ---
REDIS_URL="redis://127.0.0.1:6379"

# --- Exchange (:4010) ---
# WAL files (balances/orders after restart) live under EXCHANGE_DATA_DIR.
# Local default is ./data. In production set this to a persistent disk mount.
EXCHANGE_URL="http://127.0.0.1:4010"
EXCHANGE_PERP_URL="http://127.0.0.1:4010"
EXCHANGE_PORT=4010
EXCHANGE_GATEWAY_TOKEN="local-dev-exchange-token"
# EXCHANGE_DATA_DIR="/var/lib/cex/exchange"
# EXCHANGE_MARKETS="SOL-USD,SOL-USD-PERP"

# --- Engine gateway (:4020) ---
GATEWAY_PORT=4020
GATEWAY_INTERNAL_TOKEN="local-dev-gateway-token"
ENGINE_GATEWAY_URL="http://127.0.0.1:4020"
ENGINE_GATEWAY_INTERNAL_TOKEN="local-dev-gateway-token"
# Browser-reachable gateway URL for live SSE (defaults to ENGINE_GATEWAY_URL).
# ENGINE_GATEWAY_PUBLIC_URL="https://gateway.example.com"
# Must match GATEWAY_INTERNAL_TOKEN (used to sign/verify SSE tickets).
# Optional CORS allowlist (default *: SSE is ticket-gated)
# CORS_ORIGINS="http://localhost:3000,https://your-app.vercel.app"

# --- OMS (:4030) ---
OMS_URL="http://127.0.0.1:4030"
OMS_INTERNAL_TOKEN="local-dev-oms-token"

# --- Next.js web (apps/web/.env) — fill Google + NEXTAUTH to sign in ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
# Production: set to your public site URL. On Vercel, falls back to https://$VERCEL_URL.
NEXTAUTH_URL=http://localhost:3000
# Optional: restrict Google emails (default @gmail.com; empty = any email)
# AUTH_EMAIL_SUFFIX=@gmail.com

# Optional: set SIM_HEARTBEAT=false to disable in-app market-maker (default: on)
# SIM_HEARTBEAT=false
