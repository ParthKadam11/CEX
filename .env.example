# Database (used by @cex/db / Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/cex"

# NextAuth (apps/web/.env — Next only loads env from the app directory)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Solana RPC — put in apps/web/.env
# This project uses Devnet/Testnet SOL only (not mainnet USDC/USDT).
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
