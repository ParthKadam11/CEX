generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Provider {
  Google
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  LIMIT
  MARKET
}

enum OrderTimeInForce {
  GTC
  IOC
  FOK
  FOK_BUDGET
}

enum OmsOrderStatus {
  PENDING
  ACCEPTED
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCEL_REQUESTED
  CANCELLED
  REJECTED
  FAILED
}

model User {
  id          String     @id @default(uuid())
  username    String     @unique
  email       String     @unique
  name        String?
  password    String?
  profilePic  String?
  solwallet   SolWallet?
  provider    Provider
  orders      Order[]
  deposits    Deposit[]
}

/// Per-user custodial Devnet deposit address. Secret is AES-GCM encrypted.
model SolWallet {
  id                  String    @id @default(uuid())
  publicKey           String    @unique
  encryptedPrivateKey String
  /// Newest processed inbound signature (scan cursor).
  lastSignature       String?
  lastScannedAt       DateTime?
  createdAt           DateTime  @default(now())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id])
}

enum DepositStatus {
  SEEN
  CREDITING
  CREDITED
  FAILED
  IGNORED
}

/// On-chain Devnet SOL deposit → engine CREDIT (commandId = deposit:<signature>).
model Deposit {
  id            String        @id @default(uuid())
  signature     String        @unique
  userId        String
  publicKey     String
  lamports      BigInt
  lots          Int
  status        DepositStatus @default(SEEN)
  commandId     String?       @unique
  slot          BigInt?
  failureReason String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  creditedAt    DateTime?
  user          User          @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model Order {
  id              String           @id @default(uuid())
  engineOrderId   String           @unique
  placeCommandId  String           @unique
  cancelCommandId String?          @unique
  clientOrderId   String
  userId          String
  market          String
  side            OrderSide
  type            OrderType
  timeInForce     OrderTimeInForce
  price           Int
  quantity        Int
  quoteBudget     Int?
  // Perp leverage at place time (null for spot).
  leverage        Int?
  filledQuantity      Int              @default(0)
  lastEngineSequence  Int              @default(0)
  status              OmsOrderStatus   @default(PENDING)
  failureReason       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id])
  fills           OrderFill[]

  @@unique([userId, clientOrderId])
  @@index([userId, createdAt])
  @@index([userId, createdAt, id])
  @@index([userId, status])
}

model OrderFill {
  id        String   @id @default(uuid())
  orderId   String
  tradeId   String
  price     Int
  quantity  Int
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, tradeId])
  @@index([orderId, createdAt])
}

model CommandOutbox {
  id          String    @id @default(uuid())
  commandId   String    @unique
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt, createdAt])
}

model OmsProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  commandId   String?
  orderId     String?
  eventType   String
  processedAt DateTime @default(now())

  @@index([orderId, processedAt])
}
