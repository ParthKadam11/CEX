generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Provider {
  Google
}

enum OrderSide {
  BUY
  SELL
}

enum OrderType {
  LIMIT
  MARKET
}

enum OrderTimeInForce {
  GTC
  IOC
  FOK
  FOK_BUDGET
}

enum OmsOrderStatus {
  PENDING
  ACCEPTED
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCEL_REQUESTED
  CANCELLED
  REJECTED
  FAILED
}

model User {
  id            String      @id @default(uuid())
  username      String      @unique
  email         String      @unique
  name          String?
  password      String?
  profilePic    String?
  solWalletId   String?
  solwallet     SolWallet?
  usdWalletId   String?
  usdWallet     UsdWallet?
  provider      Provider
  orders        Order[]
}

/// Simulated USD quote currency — DB only (not on-chain).
model UsdWallet {
  id          String  @id @default(uuid())
  balance     Int
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id])
}

model SolWallet {
  id          String  @id @default(uuid())
  publicKey   String
  privateKey  String
  userId      String  @unique
  user        User    @relation(fields: [userId], references: [id])
}

model Order {
  id              String           @id @default(uuid())
  engineOrderId   String           @unique
  placeCommandId  String           @unique
  cancelCommandId String?          @unique
  clientOrderId   String
  userId          String
  market          String
  side            OrderSide
  type            OrderType
  timeInForce     OrderTimeInForce
  price           Int
  quantity        Int
  quoteBudget     Int?
  filledQuantity      Int              @default(0)
  lastEngineSequence  Int              @default(0)
  status              OmsOrderStatus   @default(PENDING)
  failureReason       String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User             @relation(fields: [userId], references: [id])
  fills           OrderFill[]

  @@unique([userId, clientOrderId])
  @@index([userId, createdAt])
  @@index([userId, createdAt, id])
  @@index([userId, status])
}

model OrderFill {
  id        String   @id @default(uuid())
  orderId   String
  tradeId   String
  price     Int
  quantity  Int
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, tradeId])
  @@index([orderId, createdAt])
}

model CommandOutbox {
  id          String    @id @default(uuid())
  commandId   String    @unique
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([publishedAt, createdAt])
}

model OmsProcessedEvent {
  id          String   @id @default(uuid())
  eventId     String   @unique
  commandId   String?
  orderId     String?
  eventType   String
  processedAt DateTime @default(now())

  @@index([orderId, processedAt])
}
